<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tahoe 27.2 frosted glass: subtle outer highlight rim -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <!-- Translucent matte glass panel with luminous border -->
    <item android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#D8232C3E"
                android:centerColor="#C019202E"
                android:endColor="#CC121622" />
            <stroke android:width="1.2dp" android:color="#59FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
